{
  "name": "snap-ebt-grocery-tracker",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test:logic": "tsc -p tsconfig.test.json && node --test .test-build/tests/money.test.js",
    "test:ui": "jest --runInBand --config jest.config.js",
    "generate:notices": "node scripts/generate-notices.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:release-metadata": "node scripts/verify-release-metadata.mjs",
    "verify:native": "node scripts/verify-native.mjs",
    "verify:legal": "node scripts/verify-legal.mjs",
    "validate": "npm run typecheck && npm run test:logic && npm run test:ui && npm run verify:package && npm run verify:native && npm run verify:legal"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "expo": "~57.0.9",
    "expo-build-properties": "~57.0.8",
    "expo-crypto": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-iap": "5.2.4",
    "expo-notifications": "~57.0.10",
    "expo-print": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-tracking-transparency": "~57.0.0",
    "jszip": "^3.10.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-google-mobile-ads": "16.4.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "26.1.2",
    "@types/react": "~19.2.2",
    "jest": "29.7.0",
    "jest-expo": "~57.0.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
